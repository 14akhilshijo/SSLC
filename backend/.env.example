# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kerala_sslc

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Kerala SSLC API Keys (Official + Mirrors)
KERALA_SSLC_API_PRIMARY=https://api.keralaresults.nic.in/sslc2026
KERALA_SSLC_API_MIRROR1=https://results.kerala.gov.in/api/sslc
KERALA_SSLC_API_MIRROR2=https://keralaresults.nic.in/sslc
KERALA_SSLC_API_KEY=your_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin
ADMIN_EMAIL=admin@sslc.akhilshijoinnov.site
ADMIN_PASSWORD=change_this_password

# CORS
ALLOWED_ORIGINS=https://sslc.akhilshijoinnov.site,http://localhost:3000

# Cache TTL (seconds)
CACHE_TTL=3600
RESULT_CACHE_TTL=86400
